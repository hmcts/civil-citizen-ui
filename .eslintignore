# /node_modules/* in the project root is ignored by default
# build artefacts
dist/*
coverage/*
# data definition files
**/*.d.ts
# 3rd party libs
/src/main/public/
# custom definition files
/src/main/types/
jest.*config.js
# Semgrep rule fixtures are parsed by Semgrep, not the application toolchain
/.semgrep/

# manual performance tool (k6), never part of lint or CI
/performance/
