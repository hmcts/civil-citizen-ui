{
  "mappings": [
    {
      "name": "thin-client-create-service-request",
      "priority": 4,
      "request": {
        "method": "POST",
        "urlPath": "/service-request",
        "bodyPatterns": [
          {
            "matchesJsonPath": "$[?(@.case_reference || @.ccd_case_number)]"
          },
          {
            "matchesJsonPath": "$.fees[0]"
          }
        ]
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "transformers": [
          "response-template"
        ],
        "body": "{\"service_request_reference\":\"2026-THIN-CLIENT-{{randomValue type='UUID'}}\"}"
      }
    },
    {
      "name": "thin-client-create-claim-card-payment",
      "priority": 3,
      "request": {
        "method": "POST",
        "urlPathPattern": "/service-request/[^/]+/card-payments",
        "bodyPatterns": [
          {
            "matchesJsonPath": "$[?(@.amount == 455)]"
          },
          {
            "matchesJsonPath": "$[?(@.currency == 'GBP')]"
          },
          {
            "matchesJsonPath": "$['return-url']"
          }
        ]
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{{#assign 'paymentReference'}}RC-THIN-CLIENT-CLAIM-{{randomValue type='UUID'}}{{/assign}}{\"external_reference\":\"thin-client-external-{{randomValue type='UUID'}}\",\"payment_reference\":\"{{paymentReference}}\",\"status\":\"Initiated\",\"next_url\":\"__WIREMOCK_PUBLIC_URL__/thin-pay/card?payment_ref={{paymentReference}}&return_url={{urlEncode (jsonPath request.body '$.return-url')}}&amount=115.00\",\"date_created\":\"2026-01-01T00:00:00Z\"}",
        "transformers": [
          "response-template"
        ]
      },
      "serveEventListeners": [
        {
          "name": "recordState",
          "parameters": {
            "context": "{{jsonPath response.body '$.payment_reference'}}",
            "state": {
              "status": "Initiated",
              "returnUrl": "{{jsonPath request.body '$.return-url'}}",
              "amount": "115.00"
            }
          }
        }
      ]
    },
