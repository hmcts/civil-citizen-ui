    {
      "name": "thin-client-card-entry-page",
      "priority": 4,
      "request": {
        "method": "GET",
        "urlPath": "/thin-pay/card",
        "queryParameters": {
          "return_url": {
            "matches": "https?://.+"
          },
          "amount": {
            "matches": "[0-9]+(?:\\.[0-9]+)?"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/html; charset=utf-8"
        },
        "body": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Enter card details</title></head><body><main><h1>Enter card details</h1><h2>Payment summary</h2><p>card payment</p><p>Total amount: &pound;{{request.query.amount}}</p><p>We’ll send your payment confirmation here</p><form method=\"get\" action=\"/thin-pay/confirm\"><input type=\"hidden\" name=\"return_url\" value=\"{{request.query.return_url}}\"><input type=\"hidden\" name=\"amount\" value=\"{{request.query.amount}}\"><label>Card number<input id=\"card-no\" name=\"card-no\"></label><label>Expiry month<input id=\"expiry-month\" name=\"expiry-month\"></label><label>Expiry year<input id=\"expiry-year\" name=\"expiry-year\"></label><label>Name on card<input id=\"cardholder-name\" name=\"cardholder-name\"></label><label>Security code<input id=\"cvc\" name=\"cvc\"></label><label>Address line 1<input id=\"address-line-1\" name=\"address-line-1\" autocomplete=\"billing address-line1\"></label><label>Town or city<input id=\"address-city\" name=\"address-city\"></label><label>Postcode<input id=\"address-postcode\" name=\"address-postcode\"></label><label>Email<input id=\"email\" name=\"email\"></label><button type=\"submit\">Continue</button></form></main></body></html>",
        "transformers": [
          "response-template"
        ]
      }
    },
    {
      "name": "thin-client-confirm-card-payment-page",
      "priority": 4,
      "scenarioName": "thin-client-payment",
      "requiredScenarioState": "PaymentCreated",
      "newScenarioState": "Confirmed",
      "request": {
        "method": "GET",
