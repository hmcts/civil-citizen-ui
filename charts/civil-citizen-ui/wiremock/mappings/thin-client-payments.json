        "body": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><title>Confirm your payment</title></head><body><main><h1>Confirm your payment</h1><h2>Payment summary</h2><p>card payment</p><p>Total amount: &pound;{{request.query.amount}}</p><form method=\"get\" action=\"/thin-pay/complete\"><input type=\"hidden\" name=\"payment_ref\" value=\"{{request.query.payment_ref}}\"><input type=\"hidden\" name=\"return_url\" value=\"{{request.query.return_url}}\"><input type=\"hidden\" name=\"amount\" value=\"{{request.query.amount}}\"><button id=\"confirm\" type=\"submit\">Confirm payment</button></form></main></body></html>",
        "transformers": [
          "response-template"
        ]
      },
      "serveEventListeners": [
