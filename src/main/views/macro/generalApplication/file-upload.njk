{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% macro gaFileUpload(t, params) %}
  {% set uploadedRows = (params.summaryRows or []) | selectattr("actions") %}
  <div class="file-upload-slots" data-single-upload-box="true"{% if uploadedRows.length %} data-has-uploaded-files="true"{% endif %}
    data-file-type-error="{{ t('ERRORS.VALID_MIME_TYPE_FILE') }}"
    data-file-size-error="{{ t('ERRORS.VALID_SIZE_FILE') }}"
    data-error-summary-title="{{ t('ERRORS.THERE_WAS_A_PROBLEM') }}"
    data-error-prefix="{{ t('ERRORS.ERROR') }}">
    {% for row in uploadedRows %}
      <div class="govuk-inset-text app-uploaded-file-slot">
        <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ t('COMMON.UPLOAD_FILE_LABEL') }}</p>
        <p class="govuk-hint">{{ t('PAGES.UPLOAD_DOCUMENTS.ADD_ANOTHER_FILE_HINT') }}</p>
        <p class="govuk-body govuk-!-margin-bottom-0 app-uploaded-file-slot__name">{{ row.key.text }}</p>
      </div>
    {% endfor %}
    <div class="row-container govuk-inset-text">
      {% if caller %}{{ caller() }}{% endif %}
      {{ govukFileUpload({
        id: params.id,
        name: "selectedFile",
        javascript: true,
        chooseFilesButtonText: t('COMMON.FILE_UPLOAD.CHOOSE_FILE'),
        dropInstructionText: t('COMMON.FILE_UPLOAD.DROP_INSTRUCTION'),
        noFileChosenText: t('COMMON.FILE_UPLOAD.NO_FILE_CHOSEN'),
        enteredDropZoneText: t('COMMON.FILE_UPLOAD.ENTERED_DROP_ZONE'),
        leftDropZoneText: t('COMMON.FILE_UPLOAD.LEFT_DROP_ZONE'),
        label: {
          text: t('COMMON.UPLOAD_FILE_LABEL'),
          classes: 'govuk-label--s'
        },
        hint: {
          text: t('PAGES.UPLOAD_DOCUMENTS.ADD_ANOTHER_FILE_HINT')
        },
        errorMessage: { text: params.errorText } if params.errorText
      }) }}
      {{ govukButton({
        id: 'uploadFileButton',
        name: 'action',
        value: 'uploadButton',
        text: t('COMMON.SAVE_FILE'),
        classes: "govuk-button--secondary govuk-!-margin-bottom-0 js-auto-upload-button",
        attributes: params.saveButtonAttributes
      }) }}
    </div>
  </div>
  <button type="button" class="govuk-button govuk-button--secondary add-file-slot govuk-!-margin-bottom-4">
    {{ t('PAGES.UPLOAD_DOCUMENTS.ADD_ANOTHER_FILE') }}
  </button>
{% endmacro %}

{% macro gaUploadedFiles(t, summaryRows) %}
  {% set rows = summaryRows or [] %}
  {% set uploadedRows = rows | selectattr("actions") %}
  <h2 class="govuk-heading-s">{{ t('PAGES.UPLOAD_DOCUMENTS.UPLOADED_FILE') }}</h2>
  <dl class="govuk-summary-list">
    {% if not uploadedRows.length %}
      <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__value">{{ t('PAGES.UPLOAD_DOCUMENTS.NO_FILE_UPLOADED') }}</dt>
      </div>
    {% endif %}
    {% for row in rows %}
      {% if row.actions %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__value app-uploaded-file">{{ row.key.text }}</dt>
          <dd class="govuk-summary-list__actions">
            {{ gaDeleteFileButton(t, row.key.text, uploadedRows.indexOf(row), row.documentId) }}
          </dd>
        </div>
      {% else %}
        <div class="govuk-summary-list__row">
          <dt class="govuk-summary-list__key">{{ row.key.text }}</dt>
          <dd class="govuk-summary-list__value">{{ row.value.text }}</dd>
        </div>
      {% endif %}
    {% endfor %}
  </dl>
{% endmacro %}

{% macro gaDeleteFileButton(t, documentName, index, documentId) %}
  {{ govukButton({
    name: 'action',
    value: 'deleteFile[' + index + '][' + documentId + ']',
    html: t('COMMON.BUTTONS.DELETE') + '<span class="govuk-visually-hidden"> ' + (documentName | escape) + '</span>',
    classes: 'govuk-button--secondary govuk-!-margin-bottom-0'
  }) }}
{% endmacro %}
