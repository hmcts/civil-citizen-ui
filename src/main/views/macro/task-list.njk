{% from "govuk/components/task-list/macro.njk" import govukTaskList %}

{% macro taskListComponent(taskLists, t, idPrefix='tasks') %}
  {% for taskList in taskLists %}
    {% set sectionId = idPrefix + '-section-' + loop.index %}
    <div class="{{ 'govuk-!-display-none' if taskList.tasks.length===0 }}" role="group" aria-labelledby="{{ sectionId }}">
      <h2 class="govuk-heading-m" id="{{ sectionId }}">
        <span>{{ loop.index }} . </span>{{ t(taskList.title) }}
      </h2>
      {{ govukTaskList({
        idPrefix: idPrefix + '-' + loop.index,
        attributes: {'aria-labelledby': sectionId},
        items: toGovukTaskListItems(taskList.tasks, t)
      }) }}
    </div>
  {% endfor %}
{% endmacro %}

{% macro dashboardTaskListComponent(taskLists, lang, idPrefix='dashboard-tasks') %}
  {% for taskList in taskLists %}
    {% set sectionId = idPrefix + '-heading-' + loop.index %}
    {% set listId = idPrefix + '-' + loop.index %}
    <div class="{{ 'govuk-!-display-none' if taskList.tasks.length===0 }}" role="group" aria-labelledby="{{ sectionId }}">
      <h2 class="govuk-heading-m" id="{{ sectionId }}">
        {{ taskList.categoryCy if lang==='cy' else taskList.categoryEn }}
      </h2>
      {{ govukTaskList({
        idPrefix: listId,
        attributes: {'aria-labelledby': sectionId},
        items: toDashboardGovukTaskListItems(taskList.tasks, lang, listId)
      }) }}
    </div>
  {% endfor %}
{% endmacro %}
