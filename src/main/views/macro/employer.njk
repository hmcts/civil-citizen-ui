{% from "govuk/components/input/macro.njk" import govukInput %}

{% macro employerRow(employer, index, errorFor,t, formErrors) %}
  {% set commonLabel = t('PAGES.WHO_EMPLOYS_YOU.JOB', { indx: index+1 }) %}
  {% set labelTemplate = t('PAGES.WHO_EMPLOYS_YOU.JOB', { indx: '%row%' }) %}
  <div class="row-container govuk-grid-column-two-thirds">
    <div class="multiple-row">
      {% set errors = formErrors %}
      <div class="govuk-form-group {%- if errors.length>0 %} govuk-form-group--error{% endif %}">
        <div class="govuk-grid-column-one-third govuk-!-display-inline">
          {{ govukInput({
              id: 'rows[' + index + '][employerName]',
              name: 'rows[' + index + '][employerName]',
              value: employer.employerName,
              hint: { text: t('COMMON.EMPLOYER_NAME') },
              label: {
                attributes: {'data-row-label-template': labelTemplate + t('COMMON.EMPLOYER_NAME')},
                text: commonLabel + t('COMMON.EMPLOYER_NAME'),
                classes: 'govuk-visually-hidden'
              },
              errorMessage: { text: t(errorFor('rows[' + index + '][employerName]')) } if errorFor('rows[' + index + '][employerName]') else false
            }) }}
          {{ govukInput({
              id: 'rows[' + index + '][jobTitle]',
              name: 'rows[' + index + '][jobTitle]',
              value: employer.jobTitle,
              hint: { text: t('COMMON.JOB_TITLE') },
              label: {
                attributes: {'data-row-label-template': labelTemplate + t('COMMON.JOB_TITLE')},
                text: commonLabel + t('COMMON.JOB_TITLE'),
                classes: 'govuk-visually-hidden'
              },
              errorMessage: { text: t(errorFor('rows[' + index + '][jobTitle]')) } if errorFor('rows[' + index + '][jobTitle]') else false
            }) }}
        </div>
      </div>
    </div>
  </div>
{% endmacro %}
