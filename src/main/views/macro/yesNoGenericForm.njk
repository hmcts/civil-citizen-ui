{# This macro has params that include conditional html to show on yes or no.
To include html on yes add htmlYes in parameter
for example {yesHtml:'<span>you clicked on yes</span>'}
To include html on when no is selected add htmlNo parameter
for example {noHtml:'<span>you clicked on no</span>' #}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{# Omitted legend options retain existing page-heading behaviour; callers with a
   separate heading opt out explicitly. Conditional HTML remains caller-owned. #}
{% macro yesNoRadioButton(t, id, name, title, form, description, params) %}
  {% set yes = params.yes if params.yes else 'COMMON.VARIATION.YES' %}
  {% set no = params.no if params.no else 'COMMON.VARIATION.NO' %}
  {% set legendIsPageHeading = params.isPageHeading if params and params.isPageHeading is defined else true %}
  {% set legendClasses = params.legendClasses if params and params.legendClasses is defined else "govuk-fieldset__legend--l" %}
  {{ govukRadios({
    idPrefix: id,
    name: name,
    classes: params.classes,
    fieldset: {
      legend: {
        text: title,
        isPageHeading: legendIsPageHeading,
        classes: legendClasses
      }
    } if title,
    hint: {
      text: description
    },
    items: [
      {
        value: YesNo.YES,
        checked: true if form.model.option=="yes" else false,
        html: "<span>" + t(yes) + "</span>",
        hint: {
          text: params.yesHint
        },
        conditional:{
        html: params.yesHtml
      }
      },
      {
        value: YesNo.NO,
        checked: true if form.model.option=="no" else false,
        html: "<span>" + t(no) + "</span>",
        hint: {
          text: params.noHint
        },
        conditional:{
        html: params.noHtml
      }
      }
    ],
    errorMessage: {
      html: params.errorMessageText if params and params.errorMessageText else t(form.errorFor(name))
    } if form.hasFieldError(name)
  }) }}
{% endmacro %}
