{% extends "claim-details-tpl.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "../../../macro/csrf.njk" import csrfProtection %}
{% from "../../../macro/contact-us-for-help.njk" import contactUsForHelp with context %}
{% from "../../../macro/page-title.njk" import setPageTitle %}
{% from "../../../macro/error-summary.njk" import errorSummary %}

{% block pageTitle %}
  {{ setPageTitle(t, pageTitle) }}
{% endblock %}

{% block content %}

      {% set errors = form.getErrors() %}
      {% set dateSummaryErrors = [] %}
      {% for error in errors %}
        {% set added = dateSummaryErrors.push({text: error.text, href: '#day' if error.property in ['flightDate'] else error.href}) %}
      {% endfor %}
      {% if form.hasErrors() %}
        <div class="govuk-grid-row">
          {{ errorSummary(dateSummaryErrors, t) }}
        </div>
      {% endif %}

      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <form method="post" novalidate autocomplete="off">
            {{ csrfProtection(csrf) }}

            <h1 class="govuk-heading-l">{{ t('PAGES.FLIGHT_DETAILS.FLIGHT_DETAILS') }}</h1>
            {{ datalist | safe}}

            {{ govukInput({
              id: "flightNumber",
              name: "flightNumber",
              value: form.model.flightNumber,
              classes: "govuk-!-width-one-half",
              label: {
                text: t('PAGES.FLIGHT_DETAILS.FLIGHT_NUMBER')
              },
              errorMessage: {
                html: t(form.errorFor('flightNumber'))
              } if form.errorFor('flightNumber')
            }) }}

            {% set dateErrors = [] %}
            {% for field in ['flightDate', 'day', 'month', 'year'] %}
              {% if form.errorFor(field) %}{% set dateErrors = (dateErrors.push(t(form.errorFor(field)) | escape), dateErrors) %}{% endif %}
            {% endfor %}
            {{ govukDateInput({
              id: "flightDate",
              name: "flightDate",
              fieldset: {
                legend: {
                  text: t('PAGES.FLIGHT_DETAILS.SCHEDULED_DATE'),
                  classes: 'govuk-fieldset__legend--s'
                }
              },
              hint: {
                text: t('COMMON.DATE_EXAMPLE', {
                  date: today.getDate() + ' ' + today.getMonth() + ' ' + today.getFullYear()
                })
              },
              errorMessage: { html: dateErrors | join('<br>') } if dateErrors.length,
              items: [
                {
                  classes: "govuk-input--width-2 govuk-input--error" if form.hasFieldError('day') else "govuk-input--width-2",
                  id: "day",
                  label: t('COMMON.DAY'),
                  name: "day",
                  value: form.model.day,
                  max: 31
                },
                {
                  classes:"govuk-input--width-2 govuk-input--error" if form.hasFieldError('month') else "govuk-input--width-2",
                  id: "month",
                  label: t('COMMON.MONTH'),
                  name: "month",
                  value: form.model.month,
                  max: 12
                },
                {
                  classes: "govuk-input--width-4 govuk-input--error" if form.hasFieldError('year') else "govuk-input--width-4",
                  id: "year",
                  label: t('COMMON.YEAR'),
                  name: "year",
                  value: form.model.year,
                  max: 9999
                }
              ]
            }) }}

            <div class="govuk-form-group">
              {{ govukButton({
                text: t('COMMON.BUTTONS.SAVE_AND_CONTINUE')
              }) }}
              {{ contactUsForHelp(t) }}
            </div>
          </form>
        </div>
      </div>

{% endblock %}
