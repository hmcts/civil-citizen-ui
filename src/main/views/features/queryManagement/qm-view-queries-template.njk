{% extends "claim-details-tpl-dashboard.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "../../macro/page-title.njk" import setPageTitle %}

{% block pageTitle %}
  {{ setPageTitle(t, pageTitle) }}
{% endblock %}

{% block content %}

      {% set title = t("PAGES.QM.VIEW_QUERY.PAGE_TITLE") %}

      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <h1 class="govuk-heading-l">{{ title }}</h1>
        </div>
      </div>

      {% set tableRows = [] %}
      {% for item in parentQueryItems %}
        {% set subjectHtml %}
          <a href="/case/{{ claimId }}/qm/view-query/{{ item.id }}/query-details" class="govuk-link">{{ item.subject }}</a>
        {% endset %}
        {% set tableRows = (tableRows.push([
          { html: subjectHtml },
          { text: t(item.createdBy) },
          { text: item.sentOn },
          { text: t(item.lastUpdatedBy) },
          { text: item.lastUpdatedOn },
          { text: t(item.status) }
        ]), tableRows) %}
      {% endfor %}
      {{ govukTable({
        classes: 'tableWrap',
        caption: title,
        captionClasses: 'govuk-visually-hidden',
        head: [
          { text: t('PAGES.QM.VIEW_QUERY.MESSAGE_SUBJECT') },
          { text: t('PAGES.QM.VIEW_QUERY.SENT_BY') },
          { text: t('PAGES.QM.VIEW_QUERY.SENT_ON') },
          { text: t('PAGES.QM.VIEW_QUERY.LAST_UPDATED_BY') },
          { text: t('PAGES.QM.VIEW_QUERY.LAST_UPDATED_ON') },
          { text: t('PAGES.QM.VIEW_QUERY.STATUS') }
        ],
        rows: tableRows
      }) }}


{% endblock %}
