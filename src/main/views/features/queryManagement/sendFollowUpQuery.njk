{% extends "claim-details-tpl-dashboard.njk" %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "../../macro/heading-with-caption.njk" import headingWithCaption %}
{% from "../../macro/csrf.njk" import csrfProtection %}
{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}
{% from "../../macro/button.njk" import addButton %}
{% from "../../macro/error-summary.njk" import errorSummary %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}

{% from "../../macro/uploaded-files-summary.njk" import uploadedFilesSummary, uploadedFilesSummaryWithSubmitRemove %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}
{% block pageTitle %}
  {{ setPageTitle(t, pageHeaders.pageTitle) }}
{% endblock %}

{% block nestedContent %}
  {% set uploadErrors = [] %}
  {% for error in form.getAllErrors() %}
    {% if error.text and (error.property == '' or error.property == 'selectedFile' or error.property == 'fileUpload' or 'fileUpload[' in error.property) %}
      {% set uploadErrors = (uploadErrors.push(error), uploadErrors) %}
    {% endif %}
  {% endfor %}
  {% set errors = uploadErrors[0] %}
  {% set idValue = errors.fieldName or 'selectedFile' %}
  {{ headingWithCaption(t, pageHeaders.caption, pageHeaders.heading) }}

    {{ govukWarningText({
      text: t('PAGES.QM.FOLLOW_UP_QUERY.WARNING_TEXT'),
      iconFallbackText: "Warning"
    }) }}
    <form method="post" action="{{ currentUrl }}?_csrf={{ csrf }}" enctype='multipart/form-data' novalidate>
      {{ csrfProtection(csrf) }}
      <h2 class="govuk-heading-s">{{ t('PAGES.QM.FOLLOW_UP_QUERY.BODY_TITLE') }}</h2>
      {{ govukTextarea({
        id: 'messageDetails',
        name: 'messageDetails',
        value: form.model.messageDetails,
        label: {
          text: t('PAGES.QM.FOLLOW_UP_QUERY.BODY_TITLE'),
          classes: 'govuk-visually-hidden'
      },
        hint: {
          text: t('PAGES.QM.FOLLOW_UP_QUERY.BODY_HINT')
        },
        errorMessage: {
          text: t(form.errorFor('messageDetails'))
        } if form.errorFor('messageDetails')
      }) }}

      {% set uploadHtml %}
        <h2 class="govuk-heading-s">{{ t('PAGES.QM.FOLLOW_UP_QUERY.DOCUMENTS_TITLE') }}</h2>
        {{ govukFileUpload({
          id: idValue,
          name: "selectedFile",
          label: {
            text: t('PAGES.QM.FOLLOW_UP_QUERY.DOCUMENTS_TITLE'),
            classes: 'govuk-visually-hidden'
          },
          hint: {
            html: t('PAGES.QM.FOLLOW_UP_QUERY.DOCUMENTS_HINT')
          },
          errorMessage: {
            text: t(form.errorFor(idValue))
          } if form.errorFor(idValue)
        }) }}

        {{ govukButton({
          id: 'query-upload-button',
          name: 'action',
          value: 'uploadButton',
          text: t('COMMON.SAVE_FILE'),
          classes: "govuk-button--secondary govuk-!-margin-bottom-0"
        }) }}
      {% endset %}
        {{ govukInsetText({html: uploadHtml}) }}

      {% if formattedSummary.summaryList.rows.length > 0 %}
        <h2 class="govuk-heading-m">{{ t('COMMON.UPLOADED_FILES') }}</h2>
        <div class="govuk-section-break--s govuk-section-break--visible"></div>
        {{ uploadedFilesSummaryWithSubmitRemove(formattedSummary.summaryList.rows, t('PAGES.GENERAL_APPLICATION.UPLOAD_DOCUMENTS.REMOVE_DOC')) }}
          <br>
      {% endif %}


      {{ addButton(t, 'CONTINUE', cancelUrl) }}
    </form>

{% endblock %}
