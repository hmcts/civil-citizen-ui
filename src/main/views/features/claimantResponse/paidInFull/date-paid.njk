{% extends "claim-details-tpl.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "../../../macro/csrf.njk" import csrfProtection %}
{% from "../../../macro/contact-us-for-help.njk" import contactUsForHelp with context %}
{% from "../../../macro/page-title.njk" import setPageTitle %}
{% from "../../../macro/error-summary.njk" import errorSummary %}
{% block pageTitle %}
  {{ setPageTitle(t, pageTitle) }}
{% endblock %}
{% block content %}

      {% set errors = form.getErrors() %}
      {# Focus the first editable date field for errors applying to the whole date. #}
      {% set dateSummaryErrors = [] %}
      {% for error in errors %}
        {% set added = dateSummaryErrors.push({text: error.text, href: '#day' if error.property == 'date' else error.href}) %}
      {% endfor %}
      {% if form.hasErrors() %}
        {{ errorSummary(dateSummaryErrors, t) }}
      {% endif %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <h1 class="govuk-heading-l">
            {{ t('PAGES.CLAIMANT_SETTLE_DATE.TITLE') }}
          </h1>
          <p class="govuk-body-m">{{ t('PAGES.CLAIMANT_SETTLE_DATE.PLEASE_NOTE') }}</p>
          <p class="govuk-body-m">{{ t('PAGES.CLAIMANT_SETTLE_DATE.ADDITIONALLY') }}</p>
        </div>
      </div>
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <form method="post" novalidate>
            {{ csrfProtection(csrf) }}
            <div class="govuk-form-group">
              {% set dateErrorHtml %}
                {% for error in errors | selectattr("text") %}
                  {{ t(error.text) }}{% if not loop.last %}<br>{% endif %}
                {% endfor %}
              {% endset %}
              {{ govukDateInput({
                id: "dateOfBirth",
                type: "number",
                inputmode: "numeric",
                name: "dateOfBirth",
                fieldset: {
                  legend: {
                    text: t('PAGES.CLAIMANT_SETTLE_DATE.TITLE'),
                    classes: 'govuk-visually-hidden'
                  }
                },
                hint: {
                  text: t('COMMON.DATE_EXAMPLE', {
                    date: today.getDate() + ' ' + (today.getMonth() + 1) + ' ' + (today.getFullYear() - 1)
                  })
                },
                errorMessage: {
                  html: dateErrorHtml
                } if dateErrorHtml | trim,
                items: [
                  {
                    classes: "govuk-input--width-2 govuk-input--error" if form.hasFieldError('day') or form.hasFieldError('date') else "govuk-input--width-2",
                    id: "day",
                    label: t('COMMON.DAY'),
                    name: "day",
                    value: form.model.day,
                    max: 31
                  },
                  {
                    classes:"govuk-input--width-2 govuk-input--error" if form.hasFieldError('month') or form.hasFieldError('date') else "govuk-input--width-2",
                    id: "month",
                    label: t('COMMON.MONTH'),
                    name: "month",
                    value: form.model.month,
                    max: 12
                  },
                  {
                    classes: "govuk-input--width-4 govuk-input--error" if form.hasFieldError('year') or form.hasFieldError('date') else "govuk-input--width-4",
                    id: "year",
                    label: t('COMMON.YEAR'),
                    name: "year",
                    value: form.model.year,
                    max: 9999
                  }
                ]
              }) }}
            </div>
            {{ govukButton({ text: t("COMMON.BUTTONS.SETTLE_THE_CLAIM") }) }}
          </form>
        </div>
      </div>
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-three-thirds">
          {{ contactUsForHelp(t) }}
        </div>
      </div>

{% endblock %}
