{% extends "claim-details-tpl.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "../../../macro/contact-us-for-help.njk" import contactUsForHelp with context %}
{% from "../../../macro/csrf.njk" import csrfProtection %}
{% from "../../../macro/yesNoGenericForm.njk" import yesNoRadioButton %}
{% from "../../../macro/page-title.njk" import setPageTitle %}
{% from "../../../macro/error-summary.njk" import errorSummary %}

{% block pageTitle %}
  {{ setPageTitle(t, pageTitle) }}
{% endblock %}
{% block content %}

      <div class="govuk-grid-row">
        {% if form.hasErrors() %}
          {{ errorSummary(form.getErrors(), t) }}
        {% endif %}
      </div>
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <h1 class="govuk-heading-l">{{t('PAGES.TENANCY_DEPOSIT.TITLE')}}</h1>
          <form method="post" novalidate>
            {{ csrfProtection(csrf) }}
             {{ yesNoRadioButton(t, 'option', 'option', t('PAGES.TENANCY_DEPOSIT.TITLE'), form, '', {yes: 'COMMON.VARIATION_4.YES', no: 'COMMON.VARIATION_4.NO', classes: 'govuk-radios--inline', isPageHeading: false, legendClasses: 'govuk-visually-hidden'}) }}
            <div class="govuk-form-group">
              {{ govukButton({
                text: t('COMMON.BUTTONS.SAVE_AND_CONTINUE'),
                attributes: { 'aria-label': t('COMMON.BUTTONS.SAVE_AND_CONTINUE') }
              }) }}
            </div>
          </form>
          {{ contactUsForHelp(t) }}
        </div>
      </div>

{% endblock %}
