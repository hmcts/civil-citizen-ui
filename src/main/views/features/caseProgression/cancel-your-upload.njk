{% extends "claim-details-tpl.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "../dashboard/item-content.njk" import itemContent %}
{% from "../../macro/csrf.njk" import csrfProtection %}
{% from "../../macro/contact-us-for-help.njk" import contactUsForHelp with context %}
{% from "../../macro/page-title.njk" import setPageTitle %}
{% from "../../macro/yesNoGenericForm.njk" import yesNoRadioButton %}
{% from "../../macro/error-summary.njk" import errorSummary %}


{% block pageTitle %}
  {{ setPageTitle(t, 'PAGES.EVIDENCE_UPLOAD_CANCEL.TITLE') }}
{% endblock %}

{% block content %}

      {% if form.hasErrors() %}
        {{ errorSummary(form.getAllErrors(), t) }}
      {% endif %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

          {% for content in cancelYourUploadContents %}
            {{ itemContent(content,t) }}
          {% endfor %}

          <form method="post" novalidate>
            {{ csrfProtection(csrf) }}
            {{ yesNoRadioButton(t, 'option', 'option', t('PAGES.EVIDENCE_UPLOAD_CANCEL.ARE_YOU_SURE'), form, '', {yesHtml: yesHtml, yes: 'COMMON.VARIATION_2.YES', no: 'COMMON.VARIATION_2.NO', classes: 'govuk-radios--inline', isPageHeading: false, legendClasses: 'govuk-visually-hidden'}) }}
            <div class="govuk-form-group">
              {{ govukButton({
                text: t('COMMON.BUTTONS.SUBMIT')
              }) }}
            </div>
          </form>
        </div>
        <div class="govuk-grid-column-one-third">
          {{ contactUsForHelp(t) }}
        </div>
      </div>

{% endblock %}
