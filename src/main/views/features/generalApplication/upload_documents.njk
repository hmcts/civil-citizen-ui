{% extends "claim-details-tpl-dashboard.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/file-upload/macro.njk" import govukFileUpload %}
{% from "moj/components/multi-file-upload/macro.njk" import mojMultiFileUpload %}
{% from "../../macro/page-title.njk" import setPageTitle %}
{% from "../../macro/csrf.njk" import csrfProtection %}
{% from "../../macro/heading-with-caption.njk" import headingWithCaption %}
{% from "../../macro/button.njk" import addButton %}

{% block pageTitle %}
  {{ setPageTitle(t, 'PAGES.GENERAL_APPLICATION.UPLOAD_DOCUMENTS.TITLE') }}
{% endblock %}

{% block nestedContent %}
  {% set errors = "" %}
  {% set idValue = "documents" %}
  {% if form.hasErrors() %}
    {% set errors = translateErrors(form.getAllErrors(),t)[0] %}
    {% set idValue = errors.fieldName %}
  {% endif %}

  {{ headingWithCaption(t, headerTitle, 'PAGES.GENERAL_APPLICATION.UPLOAD_DOCUMENTS.TITLE') }}
  <p class="govuk-body">{{ t('PAGES.GENERAL_APPLICATION.UPLOAD_DOCUMENTS.MSG1') }}</p>
  <p class="govuk-body">{{ t('PAGES.GENERAL_APPLICATION.UPLOAD_DOCUMENTS.NAME_DOCUMENT') }}</p>
  <p class="govuk-body">{{ t('PAGES.GENERAL_APPLICATION.UPLOAD_DOCUMENTS.DOCUMENT_TYPE_SIZE') }}</p>

  <form method="post" action="{{ currentUrl }}&_csrf={{ csrf }}" enctype="multipart/form-data" novalidate>
    {{ csrfProtection(csrf) }}

    {% set uploadHtml %}
      {{ govukFileUpload({
        id: idValue,
        name: "documents",
        classes: "moj-multi-file-upload__input",
        label: {
          text: t('COMMON.UPLOAD_FILE_LABEL'),
          classes: "govuk-label--m"
        },
        attributes: { multiple: "" },
        errorMessage: { text: t(errors.text) } if t(errors.text) else undefined
      }) }}

      {{ govukButton({
        id: "uploadFileButton",
        name: "action",
        value: "uploadButton",
        text: t('COMMON.SAVE_FILE'),
        classes: "govuk-button--secondary moj-multi-file-upload__button"
      }) }}
    {% endset %}

    {{ mojMultiFileUpload({
      uploadedFiles: {
        heading: { text: t('PAGES.GENERAL_APPLICATION.UPLOAD_DOCUMENTS.LIST_TITLE') },
        items: uploadedFiles if uploadedFiles else []
      },
      uploadHtml: uploadHtml,
      attributes: {
        "data-upload-url": ajaxUploadUrl,
        "data-delete-url": ajaxDeleteUrl
      }
    }) }}

    <div class="govuk-button-group govuk-!-margin-top-8">
      {{ addButton(t, 'CONTINUE', cancelUrl) }}
    </div>
  </form>
{% endblock %}
