{% extends "claim-details-tpl.njk" %}
{% from "govuk/components/panel/macro.njk" import govukPanel %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "../../macro/page-title.njk" import setPageTitle %}
{% from "../../macro/contact-us-for-help.njk" import contactUsForHelp with context %}

{% block pageTitle %}
  {{ setPageTitle(t, pageTitle) }}
{% endblock %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {{ govukPanel({
        titleText: t('PAGES.CANCEL_UNISSUED_CLAIM.CONFIRMATION_TITLE')
      }) }}
      <h2 class="govuk-heading-m">{{ t('COMMON.WHAT_HAPPENS_NEXT') }}</h2>
      <p class="govuk-body">{{ t('PAGES.CANCEL_UNISSUED_CLAIM.NO_FURTHER_ACTION') }}</p>
      <div class="form-group">
        {{ govukButton({
          text: t('PAGES.SUBMIT_CONFIRMATION.GO_TO_ACCOUNT'),
          href: '/dashboard'
        }) }}
      </div>
    </div>
    <div class="govuk-grid-column-one-third">
      {{ contactUsForHelp(t) }}
    </div>
  </div>
{% endblock %}
