{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/textarea/macro.njk" import govukTextarea %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}
{% macro otherWitnessItem(index, t, form, witnessItems, removeButton) %}
  {% set firstName = "witnessItems[" + index + "][firstName]" %}
  {% set lastName = "witnessItems[" + index + "][lastName]" %}
  {% set email = "witnessItems[" + index + "][email]" %}
  {% set telephone = "witnessItems[" + index + "][telephone]" %}
  {% set details = "witnessItems[" + index + "][details]" %}
  {% call govukFieldset({
    classes: 'cui-add-another__item',
    legend: {html: (t('PAGES.OTHER_WITNESSES.PAGE_TITLE') | escape) + ' <span data-row-number>' + (index + 1) + '</span>', classes: 'govuk-visually-hidden'}
  }) %}
      {{ govukInput({
        id: firstName,
        name: firstName,
        attributes: {'data-name': 'witnessItems[%index%][firstName]', 'data-id': 'witnessItems[%index%][firstName]'},
        type: "text",
        autocomplete: "text",
        classes: "govuk-!-width-one-half",
        label: {
          text: t('COMMON.INPUT_LABELS.FIRST_NAME')
        },
        value: witnessItems.firstName,
        errorMessage: {
          text: t(form.errorFor(firstName))
        } if form.hasFieldError(firstName)
      }) }}
      {{ govukInput({
        id: lastName,
        name: lastName,
        attributes: {'data-name': 'witnessItems[%index%][lastName]', 'data-id': 'witnessItems[%index%][lastName]'},
        type: "text",
        autocomplete: "text",
        classes: "govuk-!-width-one-half",
        label: {
          text: t('COMMON.INPUT_LABELS.LAST_NAME_2')
        },
        value: witnessItems.lastName,
        errorMessage: {
          text: t(form.errorFor(lastName))
        } if form.hasFieldError(lastName)
      }) }}
      {{ govukInput({
        id: email,
        name: email,
        attributes: {'data-name': 'witnessItems[%index%][email]', 'data-id': 'witnessItems[%index%][email]'},
        type: "text",
        autocomplete: "text",
        classes: "govuk-!-width-one-half",
        label: {
          text: t('PAGES.OTHER_WITNESSES.EMAIL_LABEL')
        },
        value: witnessItems.email,
        errorMessage: {
          text: t(form.errorFor(email))
        } if form.hasFieldError(email)
      }) }}
      {{ govukInput({
        id: telephone,
        name: telephone,
        attributes: {'data-name': 'witnessItems[%index%][telephone]', 'data-id': 'witnessItems[%index%][telephone]'},
        type: "text",
        autocomplete: "text",
        classes: "govuk-!-width-one-half",
        label: {
          text: t('PAGES.OTHER_WITNESSES.PHONE_LABEL')
        },
        value: witnessItems.telephone,
        errorMessage: {
          text: t(form.errorFor(telephone))
        } if form.hasFieldError(telephone)
      }) }}
      {{ govukTextarea({
        id: details,
        name: details,
        attributes: {'data-name': 'witnessItems[%index%][details]', 'data-id': 'witnessItems[%index%][details]'},
        value: witnessItems.details,
        classes: "govuk-!-width-three-quarters",
        label: {
          text: t('PAGES.OTHER_WITNESSES.WHAT_THEY_WITNESSED_LABEL')
        },
        errorMessage: {
          text: t(form.errorFor(details))
        } if form.hasFieldError(details)
      }) }}
      {{ govukButton({
        text: t('PAGES.OTHER_WITNESSES.REMOVE_WITNESS'),
        classes: 'govuk-button--secondary cui-add-another__remove-button',
        type: 'button', attributes: {hidden: true}
      }) }}
  {% endcall %}
{% endmacro %}
