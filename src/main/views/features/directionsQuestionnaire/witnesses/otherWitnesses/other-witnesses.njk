{% extends "claim-details-tpl.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "../../../../macro/csrf.njk" import csrfProtection %}
{% from "../../../../macro/contact-us-for-help.njk" import contactUsForHelp with context %}
{% from "../../../../macro/page-title.njk" import setPageTitle %}
{% from "../../../../macro/yesNoGenericForm.njk" import yesNoRadioButton %}
{% from "../../../../macro/error-summary.njk" import errorSummary %}
{% from "./other-witness.njk" import otherWitnessItem %}

{% block pageTitle %}
  {{ setPageTitle(t, pageTitle) }}
{% endblock %}
{% set yesHtml %}
<div data-module="cui-add-another">
  <div class="cui-add-another__items" id="witnessItems">
  {% for witnessItems in form.model.witnessItems %}
    {{ otherWitnessItem(loop.index0, t, form, witnessItems) }}
  {% else %}
    {{ otherWitnessItem(0, t, form, {}) }}
  {% endfor %}
  </div>
  {{ govukButton({
    text: t('PAGES.OTHER_WITNESSES.ADD_ANOTHER_WITNESS'),
    classes: 'govuk-button cui-add-another__add-button',
    type: 'button', attributes: {hidden: true}
  }) }}
</div>
{% endset %}
{% block content %}

      {% if form.hasErrors() %}
        <div class="govuk-grid-row">
          {{ errorSummary(form.getAllErrors(), t) }}
        </div>
      {% endif %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <h1 class="govuk-heading-l govuk-!-static-margin-bottom-2">{{ t('PAGES.OTHER_WITNESSES.PAGE_TITLE') }}</h1>
          <p class="govuk-body">{{ t('PAGES.OTHER_WITNESSES.THIS_IS_SOMEONE_WHO_CAN_CONFIRM') }}</p>
          <form method="post" novalidate autocomplete="off">
            {{ csrfProtection(csrf) }}
            {{ yesNoRadioButton(t, 'option', 'option', t('PAGES.OTHER_WITNESSES.PAGE_TITLE'), form, '', {yesHtml:yesHtml, yes: 'COMMON.YES', no: 'COMMON.NO', isPageHeading: false, legendClasses: 'govuk-visually-hidden'}) }}
            <div class="govuk-form-group">
              {{ govukButton({
                text: t('COMMON.BUTTONS.SAVE_AND_CONTINUE'),
                type: "submit"
              }) }}
              {{ contactUsForHelp(t) }}
            </div>
          </form>
        </div>
      </div>

{% endblock %}
