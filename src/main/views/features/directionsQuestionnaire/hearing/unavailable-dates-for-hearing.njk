{% extends "claim-details-tpl.njk" %}
{% from "../../../macro/csrf.njk" import csrfProtection %}
{% from "../../../macro/contact-us-for-help.njk" import contactUsForHelp with context %}
{% from "../../../macro/page-title.njk" import setPageTitle %}
{% from "../../../macro/unavailable-date-row.njk" import unavailableDateRow %}
{% from "../../../macro/error-summary.njk" import errorSummary %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}

{% block pageTitle %}
  {{ setPageTitle(t, pageTitle) }}
{% endblock %}

{% set rowNumberToShowRemoveButton = 2 %}
{% set isRemoveButtonHidden = form.model.items.length < rowNumberToShowRemoveButton %}
{% set itemsErrors = form.errorFor('items') %}

{% block content %}

  {% if form.hasErrors() %}
    {{ errorSummary(form.getAllErrors(), t) }}
  {% endif %}


      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

          <form data-module="cui-append-row" data-row-name-prefix="items" data-row-id-prefixes='["items-%index%-", "conditional-items-%index%-"]' data-row-selector="[data-append-row]" method="post" novalidate>
            {{ csrfProtection(csrf) }}

            {% call govukFieldset({
              legend: {
                text: t('PAGES.UNAVAILABLE_DATES_FOR_HEARING.TITLE'),
                classes: "govuk-fieldset__legend--l",
                isPageHeading: true
              }
            }) %}

            {% for unavailableDate in form.model.items %}
              <div data-append-row role="group" aria-label="{{ t('PAGES.UNAVAILABLE_DATES_FOR_HEARING.TITLE') }} {{ loop.index }}" data-row-aria-label-template="{{ t('PAGES.UNAVAILABLE_DATES_FOR_HEARING.TITLE') }} %row%">
                {{ unavailableDateRow(unavailableDate, 'PAGES.UNAVAILABLE_DATES_FOR_HEARING.TITLE', loop.index0, form.errorFor, t, {hidden:isRemoveButtonHidden}, today) }}
              </div>
            {% else %}
              <div data-append-row role="group" aria-label="{{ t('PAGES.UNAVAILABLE_DATES_FOR_HEARING.TITLE') }} 1" data-row-aria-label-template="{{ t('PAGES.UNAVAILABLE_DATES_FOR_HEARING.TITLE') }} %row%">
                {{ unavailableDateRow(unavailableDate, 'PAGES.UNAVAILABLE_DATES_FOR_HEARING.TITLE', 0, form.errorFor, t, {hidden:true}, today) }}
              </div>
            {% endfor %}

            {% endcall %}

            <div class="govuk-!-margin-top-6">
              {{ govukButton({
                type: "button", attributes: {hidden: true},
                text: t('PAGES.UNAVAILABLE_DATES_FOR_HEARING.ADD_ANOTHER_DATE'),
                classes: "govuk-button--secondary append-row"
              }) }}
            </div>
            <div class="govuk-form-group">
              {{ govukButton({
                text: t('COMMON.BUTTONS.SAVE_AND_CONTINUE'),
                type: "submit"
              }) }}
            </div>
          </form>

          {{ contactUsForHelp(t) }}
        </div>
      </div>


{% endblock %}
