{% extends "claim-details-tpl.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "../../macro/error-summary.njk" import errorSummary %}
{% from "../../macro/yesNoGenericForm.njk" import yesNoRadioButton %}
{% from "../../macro/contact-us-for-help.njk" import contactUsForHelp with context %}
{% from "../../macro/csrf.njk" import csrfProtection %}
{% from "../../macro/page-title.njk" import setPageTitle %}
{% from "../../macro/support-required.njk" import supportRequired %}

{% block pageTitle %}
  {{ setPageTitle(t, pageTitle) }}
{% endblock %}

{# Group validation belongs to the first usable checkbox, not its wrapper div. #}
{% set errors = [] %}
{% for error in form.getAllErrors('model') %}
  {% if error.property.startsWith('model[items][') and error.property.endsWith('][checkboxGrp]') %}
    {% set rowIndex = error.property | replace('model[items][', '') | replace('][checkboxGrp]', '') %}
    {% set errors = errors.concat([{text: error.text, href: '#declared-' + rowIndex + '-disabledAccess'}]) %}
  {% else %}
    {% set errors = errors.concat([error]) %}
  {% endif %}
{% endfor %}

{% set supportDetailsHtml %}
  <div data-module="cui-add-another">
  <div class="cui-add-another__items" id="model[items]">
    {% for row in form.model.items %}
      {{ supportRequired(loop.index0, row, form.errorFor, t, {}, peopleLists[loop.index0]) }}
    {% else %}
      {{ supportRequired(0, {}, form.errorFor, t, {}, peopleLists[0]) }}
    {% endfor %}
  </div>
  <div>
    {{ govukButton({
      text: t('PAGES.SUPPORT_REQUIRED.ADD_ANOTHER'),
      classes: "govuk-button--secondary cui-add-another__add-button",
      type: "button",
      attributes: {
        "aria-label": t('PAGES.SUPPORT_REQUIRED.ADD_ANOTHER'), hidden: true
      }
    }) }}
  </div>
  </div>
{% endset %}
{% block content %}

      {% if form.hasErrors() %}
        {{ errorSummary(errors, t) }}
      {% endif %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <form method="post" novalidate>
            {{ csrfProtection(csrf) }}
            {{ yesNoRadioButton(t, 'model[option]', 'option', t('PAGES.SUPPORT_REQUIRED.TITLE'), form, t('PAGES.SUPPORT_REQUIRED.MEDIATION_TEXT') if carmEnabled else '', {yesHtml: supportDetailsHtml, yes: 'COMMON.VARIATION_3.YES', no: 'COMMON.VARIATION_3.NO'}) }}
            <div class="govuk-form-group">
              {{ govukButton({
                text: t('COMMON.BUTTONS.SAVE_AND_CONTINUE'),
                type: "submit"
              }) }}
              {{ contactUsForHelp(t) }}
            </div>
          </form>
        </div>
      </div>

{% endblock %}
