{% extends "claim-details-tpl.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/date-input/macro.njk" import govukDateInput %}
{% from "../../../macro/contact-us-for-help.njk" import contactUsForHelp with context %}
{% from "../../../macro/csrf.njk" import csrfProtection %}
{% from "../../../macro/page-title.njk" import setPageTitle %}
{% from "../../../macro/error-summary.njk" import errorSummary %}

{% block pageTitle %}
  {% if claimantView %}
    {{ setPageTitle(t, 'PAGES.CLAIMANT_DOB.PAGE_TITLE') }}
  {% else %}
    {{ setPageTitle(t, 'PAGES.CITIZEN_DOB.PAGE_TITLE') }}
  {% endif %}
{% endblock %}

{% block content %}

      {% if claimantView %}
        {% set title = t('PAGES.CLAIMANT_DOB.TITLE') %}
      {% else %}
        {% set title = t('PAGES.CITIZEN_DOB.TITLE') %}
      {% endif %}
      {% set errors = form.getErrors() %}
      {# Focus the first editable date field for errors applying to the whole date. #}
      {% set dateSummaryErrors = [] %}
      {% for error in errors %}
        {% set added = dateSummaryErrors.push({text: error.text, href: '#day' if error.property == 'dateOfBirth' else error.href}) %}
      {% endfor %}
      {% if maxDateForAge18 %}
        {% set maxDate = maxDateForAge18.toJSON() | addDaysTranslated(1, t) %}
      {% endif %}
      {% if form.hasErrors() %}
        {{ errorSummary(dateSummaryErrors,t,[{keyError:'ERRORS.VALID_ENTER_A_DATE_BEFORE',keyToReplace:'{{ maxDate }}',valueToReplace:maxDate}]) }}
      {% endif %}
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <form method="post" novalidate>
            {{ csrfProtection(csrf) }}
              {% set dateErrorHtml %}
                {% for error in errors | selectattr("text") %}
                  {{ t(error.text, {maxDate: maxDate}) }}{% if not loop.last %}<br>{% endif %}
                {% endfor %}
              {% endset %}
              {{ govukDateInput({
                id: "date",
                type: "number",
                inputmode: "numeric",
                name: "date",
                fieldset: {
                  legend: {
                    text: title,
                    classes: "govuk-fieldset__legend--l",
                    isPageHeading: true
                  }
                },
                errorMessage: {
                  html: dateErrorHtml
                } if dateErrorHtml | trim,
                hint: {
                  text: t('COMMON.DATE_EXAMPLE', {
                    date: today.getDate() + ' ' + (today.getMonth() + 1) + ' ' + (today.getFullYear() - 18)
                  })
                },
                items: [
                  {
                    classes: "govuk-input--width-2 govuk-input--error" if form.hasFieldError('day') else "govuk-input--width-2",
                    id: "day",
                    label: t('COMMON.DAY'),
                    name: "day",
                    value: form.model.day,
                    max: 31
                  },
                  {
                    classes:"govuk-input--width-2 govuk-input--error" if form.hasFieldError('month') else "govuk-input--width-2",
                    id: "month",
                    label: t('COMMON.MONTH'),
                    name: "month",
                    value: form.model.month,
                    max: 12
                  },
                  {
                    classes: "govuk-input--width-4 govuk-input--error" if form.hasFieldError('year') else "govuk-input--width-4",
                    id: "year",
                    label: t('COMMON.YEAR'),
                    name: "year",
                    value: form.model.year,
                    max: 9999
                  }
                ]
              }) }}
            {{ govukButton({
                text: t("COMMON.BUTTONS.SAVE_AND_CONTINUE"),
                attributes: { 'aria-label': t('COMMON.BUTTONS.SAVE_AND_CONTINUE') }
                }) }}
          </form>
        </div>
      </div>
      <div class="govuk-grid-row">
        <div class="govuk-grid-column-three-thirds">
          {{ contactUsForHelp(t) }}
        </div>
      </div>

{% endblock %}
