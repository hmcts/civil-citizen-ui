{% extends "claim-details-tpl.njk" %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/character-count/macro.njk" import govukCharacterCount %}
{% from "govuk/components/warning-text/macro.njk" import govukWarningText %}
{% from "../../macro/contact-us-for-help.njk" import contactUsForHelp with context %}
{% from "../../macro/csrf.njk" import csrfProtection %}
{% from "../../macro/page-title.njk" import setPageTitle %}
{% from "../../macro/error-summary.njk" import errorSummary %}
{% block pageTitle %}
  {{ setPageTitle(t, pageTitle) }}
{% endblock %}
{% block content %}
  {% set errors = form.getErrors() %}
  {% if form.hasErrors() %}
    {{ errorSummary(errors, t) }}
  {% endif %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">{{ t('PAGES.CANCEL_UNISSUED_CLAIM_SPEC.TITLE') }}</h1>
      {{ govukWarningText({
        text: t('PAGES.CANCEL_UNISSUED_CLAIM_SPEC.WARNING')
      }) }}
      <form method="post" novalidate>
        {{ csrfProtection(csrf) }}
        {{ govukCharacterCount({
          name: "cancelReason",
          id: "cancelReason",
          maxlength: maxLength,
          value: form.model.cancelReason,
          label: {
            text: t('PAGES.CANCEL_UNISSUED_CLAIM_SPEC.REASON_LABEL'),
            classes: "govuk-label--s"
          },
          textareaDescriptionText: t('PAGES.CANCEL_UNISSUED_CLAIM_SPEC.REASON_HINT'),
          charactersUnderLimitText: {
            one: t('PAGES.CANCEL_UNISSUED_CLAIM_SPEC.CHARACTERS_UNDER_LIMIT_ONE'),
            other: t('PAGES.CANCEL_UNISSUED_CLAIM_SPEC.CHARACTERS_UNDER_LIMIT_OTHER')
          },
          charactersAtLimitText: t('PAGES.CANCEL_UNISSUED_CLAIM_SPEC.CHARACTERS_AT_LIMIT'),
          charactersOverLimitText: {
            one: t('PAGES.CANCEL_UNISSUED_CLAIM_SPEC.CHARACTERS_OVER_LIMIT_ONE'),
            other: t('PAGES.CANCEL_UNISSUED_CLAIM_SPEC.CHARACTERS_OVER_LIMIT_OTHER')
          },
          errorMessage: {
            text: t(form.errorFor('cancelReason'))
          } if form.hasFieldError('cancelReason')
        }) }}
        <div class="govuk-button-group">
          {{ govukButton({
            text: t('PAGES.CANCEL_UNISSUED_CLAIM_SPEC.BUTTON'),
            attributes: { id: 'cancelUnissuedClaimButton' }
          }) }}
          <a class="govuk-link" href="{{ dashboardUrl }}">{{ t('COMMON.BUTTONS.CANCEL') }}</a>
        </div>
        {{ contactUsForHelp(t) }}
      </form>
    </div>
  </div>
{% endblock %}
