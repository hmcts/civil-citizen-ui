def checkForEnableEmailNotifications(branch_name) {
    return new GithubAPI(this).getLabelsbyPattern(branch_name, "pr-values:enableNotifyEmails").contains("pr-values:enableNotifyEmails")
}

def checkForSkipFunctionalTests(branch_name) {
  return new GithubAPI(this)
    .getLabelsbyPattern(branch_name, "pr-values:skip-functional-tests")
    .contains("pr-values:skip-functional-tests")
}

def checkForRunAllFunctionalTests(branch_name) {
  return new GithubAPI(this).getLabelsbyPattern(branch_name, "runAllFunctionalTests").contains("runAllFunctionalTests")
}

def checkForReducedStackTests(branch_name) {
  return new GithubAPI(this)
    .getLabelsbyPattern(branch_name, "pr-values:reducedStack")
    .contains("pr-values:reducedStack")
}

def generateAllureReport(String resultsDir, String reportDir, String reportLabel) {
  try {
    sh "npx allure generate ${resultsDir} --clean -o ${reportDir}"
  } catch (Exception error) {
    echo "Failed to generate ${reportLabel} Allure report. Continuing with diagnostic publication. Error: ${error.toString()}"
    currentBuild.result = 'FAILURE'
  }
}

def publishAllureHtml(String reportDir, String reportName) {
  try {
    publishHTML([
      allowMissing: true,
      alwaysLinkToLastBuild: true,
      keepAll: true,
      reportDir: reportDir,
      reportFiles: 'index.html',
      reportName: reportName
    ])
  } catch (Exception error) {
    echo "Failed to publish ${reportName}. Continuing with artifact archiving. Error: ${error.toString()}"
    currentBuild.result = 'FAILURE'
  }
}

def archiveDiagnosticArtifacts(String artifactPattern, String artifactLabel) {
  try {
    archiveArtifacts allowEmptyArchive: true, artifacts: artifactPattern
  } catch (Exception error) {
    echo "Failed to archive ${artifactLabel}. Continuing so the primary test result is preserved. Error: ${error.toString()}"
    currentBuild.result = 'FAILURE'
  }
}

def generateFunctionalFailureSummary() {
  try {
    sh 'node src/test/functionalTests/diagnostics/generateFunctionalFailureSummary.js'
  } catch (Exception error) {
    echo "Failed to generate functional failure summary. Continuing with diagnostic publication. Error: ${error.toString()}"
    currentBuild.result = 'FAILURE'
  }
}

def collectWiremockDiagnostics() {
  try {
    sh 'node src/test/functionalTests/diagnostics/collectWiremockDiagnostics.js'
  } catch (Exception error) {
    echo "Failed to collect WireMock diagnostics. Continuing with artifact archiving. Error: ${error.toString()}"
    currentBuild.result = 'FAILURE'
  }
}

def runPreviewSecurityDiagnostics() {
  try {
    sh './bin/run-preview-playwright-tests.sh'
  } catch (Exception error) {
    echo "Preview security tests failed after functional-test execution. Continuing with security diagnostic publication. Error: ${error.toString()}"
    currentBuild.result = 'FAILURE'
  }
}

withPipeline(type, product, component) {
  pipelineConf = config
  disableLegacyDeployment()
  enableAksStagingDeployment()
  enableSlackNotifications('#civil_notifications')
  enableSlackNotifications('#citizen-ui-techteam')
  syncBranchesWithMaster(branchesToSync)

  onPR {
    enablePactAs([AppPipelineDsl.PactRoles.CONSUMER])
    env.ENVIRONMENT = "preview"
    env.A11Y_CHUNKS=4
    env.NODE_OPTIONS= "--max-old-space-size=8192"
    env.NODE_TLS_REJECT_UNAUTHORIZED = "0"
    env.PR_FT_GROUPS = getFunctionalTestsGroups()
    env.CIVIL_SERVICE_IMAGE = getCivilServiceImage()
    env.REDUCED_STACK_TESTS = checkForReducedStackTests(env.BRANCH_NAME).toString()
    def civilCcdDefinitionBranch = getCivilCcdDefinitionBranch()
    generalappCCDBranch = civilCcdDefinitionBranch
    loadVaultSecrets(secrets)
  }
  onMaster {
    enablePactAs([AppPipelineDsl.PactRoles.CONSUMER])
    env.ENVIRONMENT="aat"
    env.NODE_OPTIONS= "--max-old-space-size=8192"
    env.NODE_TLS_REJECT_UNAUTHORIZED = "0"
    loadVaultSecrets(secrets)
  }
  onDemo {
    env.ENVIRONMENT = "demo"
    loadVaultSecrets(secrets)
  }

  afterSuccess('build') {
    yarnBuilder.yarn('build')
    yarnBuilder.yarn('test:integration')
  }

  before('smoketest:preview') {
    setUrls("civil-citizen-ui-pr-${CHANGE_ID}")
    if (env.REDUCED_STACK_TESTS == 'true') {
      echo 'Reduced-stack preview selected; skipping Civil Service, CCD and Camunda data setup.'
    } else {
      sh """
          eval \$(./bin/variables/load-preview-environment-variables.sh ${CHANGE_ID})
          ./bin/pull-latest-civil-shared.sh ${getCivilServiceSharedBranch()}
          . ./bin/shared/idam-get-tokens.sh
          ./bin/shared/add-roles.sh
          ./bin/pull-latest-camunda-files.sh ${getCivilServiceCamundaRef()}
          ./bin/pull-latest-dmn-files.sh ${dmnBranch}
          ./bin/pull-latest-camunda-wa-files.sh ${waStandaloneBranch}
          ./bin/import-ccd-definition.sh "-e *-prod.json,*HNL-nonprod.json,*-shuttered.json" ${getCivilCcdDefinitionBranch()}
          ./bin/import-ga-ccd-definition.sh "-e *-prod.json" ${getCivilCcdDefinitionBranch()}
          ./bin/shared/add-org-roles-to-users.sh
        """
    }
  }


  afterAlways('smoketest:preview') {
    steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'test-results/smokeTest/**/*'
    if (checkForEnableEmailNotifications(env.BRANCH_NAME)) {
      error "The 'pr-values:enableNotifyEmails' label is active on the PR. The build will be interrupted to avoid wasting build time needlessly."
    }
  }


  before('functionalTest:preview') {
    env.IDAM_STUB_ENABLED='false'
    if (env.REDUCED_STACK_TESTS != 'true') {
      copyPreviousAllureHistory()
    }
    if(checkForSkipFunctionalTests(env.BRANCH_NAME)) {
      env.SKIP_FUNCTIONAL_TESTS = true
    } else if(checkForRunAllFunctionalTests(env.BRANCH_NAME)) {
      env.RUN_ALL_FUNCTIONAL_TESTS = true
    } else {
      copyPrevFailedAndNotExecutedTestFilesJson()
    }
  }

  afterAlways('functionalTest:preview') {
    if(checkForSkipFunctionalTests(env.BRANCH_NAME)) {
      echo "Skipping Allure report generation due to label: pr-values:skip-functional-tests"
      return
    }
    generateAllureReport('test-results/functional/allure-results', 'test-results/functional/allure-report', 'functional')
    publishAllureHtml('test-results/functional/allure-report', 'Non-Prod E2E Allure Report')
    collectWiremockDiagnostics()
    generateFunctionalFailureSummary()
    archiveDiagnosticArtifacts('test-results/functional/**/*', 'functional test artifacts')

    // Security tests exercise integrations outside the reduced-stack PoC.
    if (env.REDUCED_STACK_TESTS == 'true') {
      echo 'Skipping preview security tests for the reduced-stack PoC.'
      return
    }
    runPreviewSecurityDiagnostics()
    generateAllureReport('test-results/security/allure-results', 'test-results/security/allure-report', 'security')
    publishAllureHtml('test-results/security/allure-report', 'API Security Test Report')

    archiveDiagnosticArtifacts('test-results/security/**/*', 'security test artifacts')
    try {
      junit allowEmptyResults: true, testResults: 'test-results/security/results.xml'
    } catch (Exception error) {
      echo "Failed to publish security JUnit results. Continuing so the primary test result is preserved. Error: ${error.toString()}"
      currentBuild.result = 'FAILURE'
    }
  }

  afterSuccess('smoketest:preview') {
    if (env.REDUCED_STACK_TESTS == 'true') {
      echo 'Skipping the full accessibility suite for the reduced-stack PoC.'
      return
    }
    stage('Accessibility') {
      try {
        yarnBuilder.yarn('tests:a11y:parallel')
      } catch (Exception error) {
        throw error
      } finally {
        echo 'Archiving artifacts...'
        steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'functional-output/accessibility-report/**/*'
      }
    }
  }

  before('smoketest:aat') {
    sh """
      eval \$(./bin/variables/load-staging-environment-variables.sh)
      ./bin/pull-latest-civil-shared.sh ${getCivilServiceSharedBranch()}
      . ./bin/shared/idam-get-tokens.sh
      ./bin/shared/add-roles.sh
      ./bin/pull-latest-camunda-files.sh ${camundaBranch}
      ./bin/pull-latest-dmn-files.sh ${dmnBranch}
      ./bin/pull-latest-camunda-wa-files.sh ${waStandaloneBranch}
      ./bin/import-ccd-definition.sh "-e *-nonprod.json,*COS-nonprod.json,AuthorisationCaseType-shuttered.json" ${getCivilCcdDefinitionBranch()}
      ./bin/import-ga-ccd-definition.sh "-e *-prod.json" ${getCivilCcdDefinitionBranch()}
    """
    setUrls("aat")
  }

  afterAlways('smoketest:aat') {
//    steps.archiveArtifacts allowEmptyArchive: true, artifacts: 'test-results/smokeTest/**/*'
  }


  before('functionalTest:aat') {
    env.NODE_TLS_REJECT_UNAUTHORIZED = "0"
    copyPrevFailedAndNotExecutedTestFilesJson()
    copyPreviousAllureHistory()
  }

  afterAlways('functionalTest:aat') {
    generateAllureReport('test-results/functional/allure-results', 'test-results/functional/allure-report', 'functional')
    publishAllureHtml('test-results/functional/allure-report', 'Prod E2E Allure Report')
    collectWiremockDiagnostics()
    generateFunctionalFailureSummary()
    archiveDiagnosticArtifacts('test-results/functional/**/*', 'functional test artifacts')
  }

  afterSuccess('functionalTest:aat') {
    //createGithubRelease()
    archiveDiagnosticArtifacts('test-results/functional/**/*', 'functional test artifacts')
  }
}
