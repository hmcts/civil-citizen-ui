{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>hmcts/.github:renovate-config",
    "local>hmcts/.github//renovate/automerge-minor"
  ],
  "labels": [
    "dependencies",
    "pr-values:elasticsearch"
  ],
  "timezone": "Europe/London",
  "automergeSchedule": [
    "after 7am and before 9am every weekday",
    "after 5pm and before 8pm every weekday"
  ],
  "platformAutomerge": false,
  "ignoreTests": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": "0 days",
    "prCreation": "immediate"
  },
  "schedule": [
    "after 7am and before 9am every weekday",
    "after 5pm and before 8pm every weekday"
  ],
  "rebaseWhen": "behind-base-branch",
  "automergeStrategy": "squash",
  "prConcurrentLimit": 5,
  "helmv3": {
    "bumpVersion": "patch"
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sARG .*?_VERSION=(?<currentValue>.*)\\s"]
    }
  ],
  "packageRules": [
    {
      "description": "Hold the civil-service chart at 0.0.132. From 0.0.133 (civil-service #8641) the published chart contains only java, without the CCD, XUI and Camunda stack that preview and staging here deploy",
      "matchManagers": [
        "helmv3"
      ],
      "matchDepNames": [
        "civil-service"
      ],
      "allowedVersions": "<=0.0.132"
    },
    {
      "description": "Match the seven-day Yarn npm age gate for routine updates",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict",
      "prCreation": "not-pending"
    },
    {
      "description": "Keep major updates for review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackageNames": [
        "!govuk-frontend"
      ],
      "groupName": "All non-major updates",
      "groupSlug": "all-non-major",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Keep the Terraform CLI version (infrastructure/.terraform-version) out of the npm non-major group; large jumps can affect state and providers, so review and merge manually",
      "matchManagers": [
        "terraform-version"
      ],
      "groupName": "Terraform version",
      "groupSlug": "terraform-version",
      "automerge": false
    },
    {
      "description": "Keep the cnp-jenkins-library @Library bump in Jenkinsfiles out of the npm non-major group so pipeline changes are tested on their own",
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "hmcts/cnp-jenkins-library"
      ],
      "groupName": "Jenkins library",
      "groupSlug": "jenkins-library"
    },
    {
      "matchManagers": [
        "helmv3"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Helm chart updates",
      "groupSlug": "helm-charts",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Dockerfile updates",
      "groupSlug": "dockerfile",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchPackageNames": [
        "@playwright/test",
        "playwright-core",
        "@axe-core/playwright"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Playwright",
      "groupSlug": "playwright",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Allure reporting",
      "groupSlug": "allure",
      "automerge": true,
      "automergeType": "pr",
      "matchPackageNames": [
        "/^allure-/"
      ]
    },
    {
      "matchPackageNames": [
        "eslint",
        "typescript-eslint",
        "/^@eslint//",
        "/^@typescript-eslint//",
        "/^eslint-/"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "ESLint",
      "groupSlug": "eslint",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Update stylelint and its shared configs together, majors included: each stylelint-config-standard-scss major peers on one stylelint major and enables rules only that major knows",
      "matchPackageNames": [
        "stylelint",
        "/^stylelint-/"
      ],
      "groupName": "Stylelint",
      "groupSlug": "stylelint"
    },
    {
      "matchPackageNames": [
        "typescript",
        "/^@types//"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "TypeScript",
      "groupSlug": "typescript",
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Review GOV.UK Frontend updates with rendered fixtures and journeys",
      "matchPackageNames": [
        "govuk-frontend"
      ],
      "automerge": false
    },
    {
      "description": "typescript-eslint 8 only supports TypeScript <6.1.0. Remove once typescript-eslint supports TypeScript 7.",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<6.1.0"
    },
    {
      "description": "@types/config 4 is an empty stub package (types ship with config itself).",
      "matchPackageNames": [
        "@types/config"
      ],
      "allowedVersions": "<4.0.0"
    },
    {
      "description": "@types/glob 9 is an empty stub package (types ship with glob itself).",
      "matchPackageNames": [
        "@types/glob"
      ],
      "allowedVersions": "<9.0.0"
    },
    {
      "description": "@types/uuid 11 is an empty stub package (types ship with uuid itself).",
      "matchPackageNames": [
        "@types/uuid"
      ],
      "allowedVersions": "<11.0.0"
    },
    {
      "description": "Keep Node types on the supported Node 24 runtime.",
      "matchPackageNames": [
        "@types/node"
      ],
      "allowedVersions": "<25.0.0"
    },
    {
      "description": "Keep the Multer 2 types used by the integrated upload handlers.",
      "matchPackageNames": [
        "@types/multer"
      ],
      "allowedVersions": "<3.0.0"
    },
    {
      "description": "Keep the Supertest 7 types supported by the integrated route tests.",
      "matchPackageNames": [
        "@types/supertest"
      ],
      "allowedVersions": "<8.0.0"
    },
    {
      "description": "Keep the Chai 5 types supported by the integrated test tooling.",
      "matchPackageNames": [
        "@types/chai"
      ],
      "allowedVersions": "<6.0.0"
    },
    {
      "description": "flat is only a resolutions pin (5.0.2 has the prototype-pollution fix). yargs-unparser 2 (via mocha) declares flat ^5 and calls the default export that flat 6 removed.",
      "matchPackageNames": [
        "flat"
      ],
      "allowedVersions": "<6.0.0"
    },
    {
      "description": "connect-redis 9+ only supports node-redis v5; the session and draft stores use ioredis. Remove when the app moves to node-redis.",
      "matchPackageNames": [
        "connect-redis"
      ],
      "allowedVersions": "<9.0.0"
    },
    {
      "description": "Keep CI Python on 3.13: the pinned Semgrep toolchain's pydantic-core (PyO3) only builds for Python <=3.13.",
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.14"
    },
    {
      "description": "Update Application Insights and the OpenTelemetry packages it pins (via resolutions) together and review them manually, so the overrides stay within the ranges applicationinsights and @azure/monitor-opentelemetry declare.",
      "matchPackageNames": [
        "applicationinsights",
        "@azure/monitor-opentelemetry",
        "/^@opentelemetry//"
      ],
      "groupName": "Application Insights and OpenTelemetry",
      "groupSlug": "opentelemetry",
      "automerge": false
    },
    {
      "description": "Hold the OpenTelemetry resolutions where they are: @azure/monitor-opentelemetry 1.20 declares instrumentation-http ^0.221.0 (the 0.222.0 pin is already slightly ahead), instrumentation-http 0.222.0 pins core exactly 2.11.0, and core 2.x peers on api <1.10.0. Raise all three together when Azure Monitor moves to a newer OpenTelemetry line.",
      "matchPackageNames": [
        "@opentelemetry/instrumentation-http"
      ],
      "allowedVersions": "<0.222.1"
    },
    {
      "description": "See the instrumentation-http rule: instrumentation-http 0.222.0 requires core 2.11.0 exactly.",
      "matchPackageNames": [
        "@opentelemetry/core"
      ],
      "allowedVersions": "<2.12.0"
    },
    {
      "description": "See the instrumentation-http rule: core 2.x peers on @opentelemetry/api <1.10.0.",
      "matchPackageNames": [
        "@opentelemetry/api"
      ],
      "allowedVersions": "<1.10.0"
    }
  ],
  "rangeStrategy": "pin"
}
