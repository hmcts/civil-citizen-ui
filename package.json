{
  "name": "civil-citizen-ui",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "start": "NODE_ENV=${NODE_ENV:-production} ./node_modules/.bin/ts-node -r tsconfig-paths/register src/main/server.ts",
    "start:dev": "NODE_ENV=development yarn start:redis && nodemon --config nodemon.json",
    "start:redis": "docker-compose -f ./compose/draft-store.yml up -d",
    "startwin": "NODE_ENV=development && ./node_modules/.bin/ts-node -r tsconfig-paths/register src/main/server.ts",
    "startwin:dev": "nodemon --config nodemon.json --exec yarn startwin",
    "lint": "stylelint \"**/*.scss\" -q && eslint \"**/*.{js,jsx,mjs,ts,tsx}\"",
    "lint:win": "stylelint \"**/*.scss\" -q && eslint -c eslint.config.win.mjs \"**/*.{js,jsx,mjs,ts,tsx}\"",
    "build": "webpack --config webpack.config.js",
    "build:prod": "NODE_ENV=production yarn webpack --mode production --config webpack.config.js",
    "test": "LOG_LEVEL=OFF node --disable-warning=DEP0060 --no-sparkplug ./node_modules/jest/bin/jest.js --maxWorkers=75% --silent",
    "test:coverage": "LOG_LEVEL=OFF node --disable-warning=DEP0060 --no-sparkplug ./node_modules/jest/bin/jest.js --coverage --maxWorkers=8 --silent",
    "test:routes": "node --no-sparkplug ./node_modules/jest/bin/jest.js -c jest.functionaltest.config.js --runInBand",
    "test:integration": "yarn test:routes",
    "test:a11y": "node bin/install-a11y-browser.js && yarn tests:a11y",
    "tests:a11y": "NODE_TLS_REJECT_UNAUTHORIZED=0 NODE_ENV=test LOG_LEVEL=ERROR mocha --exit --reporter mochawesome --require ts-node/register --require tsconfig-paths/register src/test/a11y/a11y.mock-test.ts --timeout 60000 --reporter-options reportDir=functional-output/accessibility-report,inlineAssets=true,reportTitle=civil-citizen-ui",
    "tests:a11y:parallel": "./src/test/a11y/run-parallel-a11y-tests.sh",
    "sonar-scan": "sonar-scanner",
    "test:smoke": "yarn playwright install && MOCHAWESOME_REPORTFILENAME=smokeTests REPORT_DIR=test-results/smokeTest codeceptjs run-workers --suites 1 --grep @smoketest --reporter mocha-multi --verbose",
    "test:civil-citizen-master": "MOCHAWESOME_REPORTFILENAME=civil-citizen-master FUNCTIONAL=true codeceptjs run-workers --suites 13 --grep '@civil-citizen-master' --reporter mocha-multi --plugins allure --verbose",
    "test:civil-citizen-pr": "MOCHAWESOME_REPORTFILENAME=civil-citizen-pr FUNCTIONAL=true WORKER_STAGGER_MS=3000 codeceptjs run-workers --suites 13 --grep '@civil-citizen-pr' --reporter mocha-multi --plugins allure --verbose",
    "test:payments": "MOCHAWESOME_REPORTFILENAME=payments FUNCTIONAL=true codeceptjs run --grep '@ui-payments' --reporter mocha-multi --plugins allure --verbose",
    "test:functional": "src/test/functionalTests/run-functional-tests.sh",
    "test:civil-citizen-nightly": "MOCHAWESOME_REPORTFILENAME=civil-citizen-nightly FUNCTIONAL=true codeceptjs run-workers --suites 10 --grep '@civil-citizen-nightly' --reporter mocha-multi --plugins allure --verbose",
    "test:fullfunctional": "./src/test/functionalTests/run-full-functional-tests.sh",
    "test:crossbrowser-functional": "MOCHAWESOME_REPORTFILENAME=crossbrowser codeceptjs run-multiple --grep @crossbrowser ${BROWSER_GROUP:-'--all'} -c src/test/functionalTests/saucelabs.conf.js --reporter mocha-multi",
    "test:crossbrowser": "src/test/functionalTests/run-crossbrowser-tests.sh",
    "test:debug": "codeceptjs run --grep @debug --plugins allure",
    "test:generate:e2e-ui-data": "node src/test/e2e-documentation/generator/e2e-data/generate-e2e-ui-data.js",
    "test:generate:e2e-api-data": "node src/test/e2e-documentation/generator/e2e-data/generate-e2e-api-data.js",
    "test:confluence:e2e-ui-table": "node src/test/e2e-documentation/confluence/e2e-table/upload-e2e-ui-table.js",
    "test:confluence:e2e-api-table": "node src/test/e2e-documentation/confluence/e2e-table/upload-e2e-api-table.js",
    "test:readme:e2e-ui-table": "node src/test/e2e-documentation/readme/e2e-table/update-e2e-ui-table.js",
    "test:readme:e2e-api-table": "node src/test/e2e-documentation/readme/e2e-table/update-e2e-api-table.js",
    "test:generate:ft-groups-ui-data": "node src/test/e2e-documentation/generator/ft-groups-data/generate-ft-groups-ui-data.js",
    "test:generate:ft-groups-api-data": "node src/test/e2e-documentation/generator/ft-groups-data/generate-ft-groups-api-data.js",
    "test:functional-baseline": "node bin/functional-baseline.js check",
    "test:confluence:ft-groups-ui-table": "node src/test/e2e-documentation/confluence/ft-groups-table/upload-ft-groups-ui-table.js",
    "test:confluence:ft-groups-api-table": "node src/test/e2e-documentation/confluence/ft-groups-table/upload-ft-groups-api-table.js",
    "test:readme:ft-groups-ui-table": "node src/test/e2e-documentation/readme/ft-groups-table/update-ft-groups-ui-table.js",
    "test:readme:ft-groups-api-table": "node src/test/e2e-documentation/readme/ft-groups-table/update-ft-groups-api-table.js",
    "cichecks": "yarn && yarn deps:check && yarn deps:audit && yarn build && yarn lint && yarn test:civil-shared-import-consumers && yarn wiremock:validate && yarn test:wiremock-contracts && yarn test:coverage && yarn test:routes",
    "cichecks:win": "yarn && yarn deps:check && yarn deps:audit && yarn build && yarn lint:win && yarn test:coverage && yarn test:routes",
    "wiremock:pull": "./bin/pull-latest-wiremock-mappings.sh",
    "wiremock:start": "yarn wiremock:pull && wiremock --root-dir ./wiremock --port 1111",
    "wiremock:validate": "node ./bin/validate-wiremock-mappings.js",
    "test:wiremock-contracts": "./bin/test-wiremock-contracts.sh",
    "test:civil-shared-import-consumers": "./bin/test-civil-shared-import-consumers.sh",
    "test:mocked-functional": "./bin/run-mocked-functional-tests.sh",
    "test:mocked-functional:browser": "MOCHAWESOME_REPORTFILENAME=reduced-stack codeceptjs run --grep '@reduced-stack' --reporter mocha-multi --verbose",
    "start:e2e": "NODE_ENV=e2eTest ./node_modules/.bin/ts-node -r tsconfig-paths/register src/main/server.ts",
    "_comment:test:e2e": "DEPRECATED (April 2026) - legacy fixed-ID e2e tests were removed; use 'yarn test:fullfunctional' instead.",
    "test:e2e": "yarn test:fullfunctional",
    "_comment:testgalip:e2e": "DEPRECATED (April 2026) - legacy @lipga tests were removed; use tests tagged @ui-ga instead.",
    "testgalip:e2e": "MOCHAWESOME_REPORTFILENAME=galip FUNCTIONAL=true codeceptjs run-workers --suites 13 --grep '@ui-ga' --reporter mocha-multi --plugins allure --verbose",
    "test:pact": "yarn test:pact:tooling && node --no-sparkplug ./node_modules/jest/bin/jest.js -c jest.pact.config.js",
    "test:pact:tooling": "node --no-sparkplug ./node_modules/jest/bin/jest.js -c jest.pact-tooling.config.js --runInBand",
    "pact:validate": "node src/test/contract/check-artifacts.js",
    "pact:publish": "ts-node src/test/contract/publish/publish.ts",
    "test:pact:run-and-publish": "yarn test:pact && yarn pact:validate && yarn pact:publish",
    "postinstall": "./bin/pull-latest-civil-shared.sh || true",
    "deps:check": "node ./bin/check-dependency-pins.mjs",
    "deps:audit": "node ./bin/check-yarn-audit.mjs",
    "start:ui-preview": "bash bin/ui-preview.sh up",
    "start:ui-preview:down": "bash bin/ui-preview.sh down",
    "start:ui-preview:logs": "bash bin/ui-preview.sh logs",
    "start:ui-preview:reset": "bash bin/ui-preview.sh reset",
    "ui-preview:validate": "node bin/ui-preview-mappings.cjs"
  },
